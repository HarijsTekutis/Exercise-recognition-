# Copy this file to studies/notify_credentials.env and fill it in.
# That filename is gitignored; this template is not. Never commit the real one.
#
# Gmail rejects account passwords over SMTP. Turn on 2-Step Verification, then create a
# 16 character App Password at https://myaccount.google.com/apppasswords and paste it
# below (spaces in it are fine to remove).

NOTIFY_SMTP_USER=your.address@gmail.com
NOTIFY_SMTP_PASSWORD=abcd efgh ijkl mnop

# Optional - these are the defaults.
# NOTIFY_EMAIL_TO=tekutisharijs@gmail.com
# NOTIFY_SMTP_HOST=smtp.gmail.com
# NOTIFY_SMTP_PORT=587
