# Auto detect text files and normalize line endings to LF
* text=auto

# Python files
*.py text eol=lf

# Jupyter notebooks - keep LF for JSON consistency
*.ipynb text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.pt binary
*.pkl binary
*.pickle binary
*.csv text eol=lf
